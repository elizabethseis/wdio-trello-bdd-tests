      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "//tests[\"Body is empty\"] = responseBody.length==2\r",
              "\r",
              "pm.test(\"Check JSON Response body is empty\", function () {\r",
              "    var jsonData = JSON.parse(responseBody)\r",
