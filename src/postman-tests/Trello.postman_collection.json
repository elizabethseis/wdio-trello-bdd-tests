  "item": [
    {
      "name": "Create a Board",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set(\"BoardName\",getRandomBoardName());\r",
              "\r",
              "function getRandomBoardName(){\r",
              "    let boardNumber = (pm.environment.get(\"boardNumber\")+1);\r",
              "    pm.environment.set(\"boardNumber\", boardNumber);\r",
              "    const BoardName= \"Board Test EPAM \" + (boardNumber+1);\r",
              "    console.log(BoardName);\r",
              "    return BoardName;\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "pm.environment.set(\"BoardId\", jsonData.id);\r",
              "console.log(\"Board Id \" + pm.environment.get(\"BoardId\"));\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "value",
              "value": "",
              "type": "string"
            },
            {
              "key": "key",
              "value": "",
              "type": "string"
            },
            {
              "key": "in",
              "value": "header",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "",
            "variables": ""
          }
        },
        "url": {
          "raw": "https://api.trello.com/1/boards/?key={{key}}&token={{token}}&name={{BoardName}}&boardNumber={{boardNumber}}",
          "protocol": "https",
          "host": ["api", "trello", "com"],
          "path": ["1", "boards", ""],
          "query": [
            {
              "key": "key",
              "value": "{{key}}"
            },
            {
              "key": "token",
              "value": "{{token}}"
            },
            {
              "key": "name",
              "value": "{{BoardName}}"
            },
            {
              "key": "boardNumber",
              "value": "{{boardNumber}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create a List TODO",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"The name of the list is TODO\", function () {\r",
              "    pm.expect(jsonData.name).to.eql(\"TODO\");\r",
              "});\r",
              "pm.test(\"Should not be closed\", function () {\r",
              "        pm.expect(jsonData.closed).to.eql(false);\r",
              "});\r",
              "\r",
              "pm.environment.set(\"ListTodoId\", jsonData.id);\r",
              "console.log(\"List Id \" + pm.environment.get(\"ListTodoId\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
