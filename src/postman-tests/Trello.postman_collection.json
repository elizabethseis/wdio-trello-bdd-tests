              "})\r",
              "\r",
              "\r",
              "let jsonData = pm.response.json();\r",
              "\r",
              "console.log(jsonData)\r",
              "if (jsonData == \"\") {\r",
              "    console.log(\"There are no more boards\")\r",
              "    postman.setNextRequest(null);\r",
              "}\r",
              "else {\r",
              "    let findId=jsonData[0].id;\r",
              "    console.log(findId);\r",
              "    pm.environment.set(\"BoardId\", findId);\r",
              "    postman.setNextRequest(\"Delete Board\");\r",
