{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": ["google"],
  "globals": {
    "$": "readonly",
    "$$": "readonly",
    "browser": "readonly"
  },
  "ignorePatterns": ["node_modules", "artifacts", "allure-report"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "require-jsdoc": "off",
    "valid-jsdoc": "off",
    "max-len": ["warn", { "code": 100 }],
    "object-curly-spacing": ["error", "always"],
    "new-cap": [
      "error",
      {
        "newIsCap": true,
        "capIsNew": false
      }
    ]
  }
}
